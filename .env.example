# Copy these settings into realtime/.env for local backend development.
# Never put real credentials in this file or into the Android/iOS/Windows app.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=smartschool_db
SESSION_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
PUBLIC_ORIGIN=https://mubuga.netlify.app
# Add other trusted frontend origins as comma-separated values when needed.
# CORS_ORIGINS=https://your-frontend.example
